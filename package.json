{
  "name": "wingsearch",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox --code-coverage",
    "lint": "ng lint",
    "http-server": "http-server -p 8080 -c-1 dist/wingsearch",
    "build-prod": "ng build --prod --output-path docs --base-href /wingsearch/ --resourcesOutputPath=assets/generated --outputHashing=bundles && cp docs/index.html docs/404.html",
    "build-local": "ng build --prod --resourcesOutputPath=assets/generated --outputHashing=bundles && cp dist/wingsearch/index.html dist/wingsearch/404.html",
    "build-pages": "ng build --prod --output-path dist/wingsearch --base-href /wingsearch/ --resourcesOutputPath=assets/generated --outputHashing=bundles && cp dist/wingsearch/index.html dist/wingsearch/404.html",
    "build-preview": "ng build --prod --output-path .preview/wingsearch --base-href /wingsearch/ --resourcesOutputPath=assets/generated --outputHashing=bundles && cp .preview/wingsearch/index.html .preview/wingsearch/404.html",
    "preview": "npm run build-preview && http-server .preview -p 8080 -c-1",
    "serve-preview": "http-server .preview -p 8080 -c-1"
  },
  "engines": {
    "node": ">=14 <15",
    "npm": ">=6 <7"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~9.1.12",
    "@angular/cdk": "^9.2.4",
    "@angular/common": "~9.1.12",
    "@angular/compiler": "~9.1.12",
    "@angular/core": "~9.1.12",
    "@angular/forms": "~9.1.12",
    "@angular/material": "^9.2.4",
    "@angular/platform-browser": "~9.1.12",
    "@angular/platform-browser-dynamic": "~9.1.12",
    "@angular/router": "~9.1.12",
    "@angular/service-worker": "~9.1.12",
    "@ngrx/effects": "^10.0.0",
    "@ngrx/router-store": "^10.0.0",
    "@ngrx/store": "^10.0.0",
    "@ngrx/store-devtools": "^10.0.0",
    "flexsearch": "^0.6.32",
    "ng5-slider": "^1.2.4",
    "ngx-infinite-scroll": "^9.1.0",
    "rxjs": "~6.5.4",
    "tslib": "^1.10.0",
    "zone.js": "~0.10.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~0.901.12",
    "@angular/cli": "~9.1.12",
    "@angular/compiler-cli": "~9.1.12",
    "@types/jasmine": "~3.5.0",
    "@types/node": "^12.12.55",
    "codelyzer": "^5.1.2",
    "http-server": "~14.1.1",
    "jasmine-core": "~3.5.0",
    "karma": "~5.0.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~2.1.0",
    "karma-jasmine": "~3.0.1",
    "karma-jasmine-html-reporter": "^1.4.2",
    "ts-node": "~8.3.0",
    "tslint": "~6.1.0",
    "typescript": "~3.8.3"
  }
}
