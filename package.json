{
  "name": "wingsearch",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox --code-coverage",
    "lint": "ng lint",
    "http-server": "http-server -p 8080 -c-1 dist/wingsearch",
    "build-local": "ng build --configuration production --output-hashing=bundles && cp dist/wingsearch/index.html dist/wingsearch/404.html",
    "build-pages": "ng build --configuration production --base-href /wingsearch/ --output-hashing=bundles && cp dist/wingsearch/index.html dist/wingsearch/404.html",
    "build-preview": "ng build --configuration production,preview --output-hashing=bundles && cp .preview/wingsearch/index.html .preview/wingsearch/404.html",
    "preview": "npm run build-preview && http-server .preview -p 8080 -c-1",
    "serve-preview": "http-server .preview -p 8080 -c-1"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  },
  "private": true,
  "dependencies": {
    "@angular-slider/ngx-slider": "^22.0.0",
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/material": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@angular/service-worker": "^22.1.4",
    "@ngrx/effects": "^22.0.0",
    "@ngrx/router-store": "^22.0.0",
    "@ngrx/store": "^22.0.0",
    "@ngrx/store-devtools": "^22.0.0",
    "flexsearch": "0.6.32",
    "ngx-infinite-scroll": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.4",
    "@eslint/js": "^9.36.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^22.0.0",
    "eslint": "^9.36.0",
    "http-server": "~14.1.1",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.44.1"
  }
}
