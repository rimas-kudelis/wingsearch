# The JSON under src/assets/data is generated by the notebooks in scripts/transform and committed,
# so its line endings are part of the contract between a maintainer's machine and the repo. Pin them
# to LF: language-to-json used to write whatever the platform's text mode produced, and regenerating
# one language on Windows rewrote all eleven files as a 66,000-line no-op that buried the one line
# that had actually changed.
src/assets/data/**/*.json text eol=lf

# Spreadsheets are zip archives. Never diff or normalize them, whatever a translator's core.autocrlf
# happens to be set to.
*.xlsx binary
